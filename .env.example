PORT=5000
NODE_ENV=development

# XAMPP MySQL defaults
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mychoize
DB_CONNECTION_LIMIT=10

JWT_SECRET=change_this_to_a_secure_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Get this from Google AI Studio or Google Cloud and keep it secret.
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here
GOOGLE_AI_STUDIO_MODEL=text-bison-001
GOOGLE_AI_STUDIO_TEMPERATURE=0.1
GOOGLE_AI_STUDIO_MAX_OUTPUT_TOKENS=150
GOOGLE_AI_STUDIO_MAX_PROMPT_CHARS=512
GOOGLE_AI_STUDIO_REQUEST_TIMEOUT_MS=8000

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

COOKIE_SECRET=change_this_to_a_secure_random_secret
